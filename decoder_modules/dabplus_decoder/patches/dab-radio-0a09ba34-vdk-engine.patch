@@ -0,0 +1,437 @@
+#include "./coherent_demapper.h"
+#include <math.h>
+#include <cmath>
+#include <string.h>
+#include <algorithm>
+#include <fftw3.h>
+
+#ifndef _WIN32
+#include <stdlib.h>
+#define _aligned_malloc(size, alignment) aligned_alloc(alignment, size)
+#define _aligned_free free
+#else
+#include <malloc.h>
+#endif
+
+#define DEFAULT_ALIGNMENT 64
+#define PI_F 3.14159265358979f
+#define TapThreshold 128.0f
+#define TapMargin 16
+#define MaxWindowShare 0.9f
+#define PilotNoiseNeighbours 8
+#define DataNoiseNeighbours 64
+#define CoarseDistance 32
+#define FineDistance 256
+#define TimingGain 0.5f
+#define RateGain 0.03f
+#define MaxTimingRate 0.001f
+#define MaxLogLikelihood 15.0f
+#define MinProbability 1e-15f
+#define TinyProbability 1e-30f
+#define LLRScale 16.0f
+
+static void* AllocateZeroed(size_t size)
+{
+	auto rounded = (size + DEFAULT_ALIGNMENT - 1) / DEFAULT_ALIGNMENT * DEFAULT_ALIGNMENT;
+	auto buffer = _aligned_malloc(rounded, DEFAULT_ALIGNMENT);
+	memset(buffer, 0, rounded);
+	return buffer;
+}
+
+static inline viterbi_bit_t ToSoftBit(float llr)
+{
+	const auto high = (float)SOFT_DECISION_VITERBI_HIGH;
+	auto value = llr * LLRScale;
+	if (!std::isfinite(value))
+	{
+		return 0;
+	}
+	return (viterbi_bit_t)std::min(high, std::max(-high, value));
+}
+
+static inline std::complex<float> NearestAxis(std::complex<float> v)
+{
+	if (fabsf(v.real()) >= fabsf(v.imag()))
+	{
+		return std::complex<float>(v.real() > 0.0f ? 1.0f : -1.0f, 0.0f);
+	}
+	return std::complex<float>(0.0f, v.imag() > 0.0f ? 1.0f : -1.0f);
+}
+
+CoherentDemapper::CoherentDemapper(int carriers, int fftSize, int symbolPeriod, const std::complex<float>* prsFft) :
+	_carriers(carriers),
+	_fftSize(fftSize),
+	_symbolPeriod(symbolPeriod),
+	_snr(0.0f),
+	_timingRate(0.0f),
+	_windowLength(0),
+	_secondPass(false)
+{
+	auto complexCarriers = sizeof(std::complex<float>) * carriers;
+	auto floatCarriers = sizeof(float) * carriers;
+	_bin = (int*)AllocateZeroed(sizeof(int) * carriers);
+	_index = (int*)AllocateZeroed(sizeof(int) * carriers);
+	_prs = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_channel = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_smooth = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_reference = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_symbol = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_residual = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_rotation = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_rotationFirst = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_sum = (std::complex<float>*)AllocateZeroed(complexCarriers);
+	_timeIn = (std::complex<float>*)AllocateZeroed(sizeof(std::complex<float>) * fftSize);
+	_timeOut = (std::complex<float>*)AllocateZeroed(sizeof(std::complex<float>) * fftSize);
+	_noise = (float*)AllocateZeroed(floatCarriers);
+	_norm = (float*)AllocateZeroed(floatCarriers);
+	_weight = (float*)AllocateZeroed(floatCarriers);
+	_power = (float*)AllocateZeroed(sizeof(float) * fftSize);
+	_sorted = (float*)AllocateZeroed(sizeof(float) * fftSize);
+	_previous = (float*)AllocateZeroed(floatCarriers * 4);
+	_llrRe = (float*)AllocateZeroed(floatCarriers);
+	_llrIm = (float*)AllocateZeroed(floatCarriers);
+
+	auto c = 0;
+	for (int i = -carriers / 2; i <= carriers / 2; i++)
+	{
+		if (i == 0)
+		{
+			continue;
+		}
+		_index[c] = i;
+		_bin[c] = (i + fftSize) % fftSize;
+		auto value = prsFft[_bin[c]];
+		auto magnitude = std::abs(value);
+		_prs[c] = magnitude > 0.0f ? value / magnitude : std::complex<float>(1.0f, 0.0f);
+		c++;
+	}
+
+	_forward = fftwf_plan_dft_1d(fftSize, (fftwf_complex*)_timeIn, (fftwf_complex*)_timeOut, FFTW_FORWARD, FFTW_ESTIMATE);
+	_backward = fftwf_plan_dft_1d(fftSize, (fftwf_complex*)_timeIn, (fftwf_complex*)_timeOut, FFTW_BACKWARD, FFTW_ESTIMATE);
+}
+
+CoherentDemapper::~CoherentDemapper()
+{
+	fftwf_destroy_plan(_forward);
+	fftwf_destroy_plan(_backward);
+	_aligned_free(_bin);
+	_aligned_free(_index);
+	_aligned_free(_prs);
+	_aligned_free(_channel);
+	_aligned_free(_smooth);
+	_aligned_free(_reference);
+	_aligned_free(_symbol);
+	_aligned_free(_residual);
+	_aligned_free(_rotation);
+	_aligned_free(_rotationFirst);
+	_aligned_free(_sum);
+	_aligned_free(_timeIn);
+	_aligned_free(_timeOut);
+	_aligned_free(_noise);
+	_aligned_free(_norm);
+	_aligned_free(_weight);
+	_aligned_free(_power);
+	_aligned_free(_sorted);
+	_aligned_free(_previous);
+	_aligned_free(_llrRe);
+	_aligned_free(_llrIm);
+}
+
+void CoherentDemapper::Rotate(float phase, float slope, std::complex<float>* out)
+{
+	auto step = std::polar(1.0f, -slope);
+	auto value = std::polar(1.0f, -(phase + slope * (float)_index[0]));
+	out[0] = value;
+	for (int i = 1; i < _carriers; i++)
+	{
+		for (int j = _index[i - 1]; j < _index[i]; j++)
+		{
+			value *= step;
+		}
+		out[i] = value;
+	}
+}
+
+void CoherentDemapper::SmoothChannel()
+{
+	const auto fftSize = _fftSize;
+	const auto bytes = sizeof(std::complex<float>) * fftSize;
+
+	memset(_timeIn, 0, bytes);
+	for (int i = 0; i < _carriers; i++)
+	{
+		_timeIn[_bin[i]] = _channel[i];
+	}
+	fftwf_execute(_backward);
+
+	auto peak = 0;
+	for (int i = 0; i < fftSize; i++)
+	{
+		_power[i] = std::norm(_timeOut[i]);
+		if (_power[i] > _power[peak])
+		{
+			peak = i;
+		}
+	}
+	memcpy(_sorted, _power, sizeof(float) * fftSize);
+	std::nth_element(_sorted, _sorted + fftSize / 2, _sorted + fftSize);
+	const auto threshold = TapThreshold * _sorted[fftSize / 2];
+
+	auto first = 0;
+	auto last = 0;
+	for (int i = -fftSize / 4; i < fftSize / 4; i++)
+	{
+		if (_power[(peak + i + fftSize) % fftSize] > threshold)
+		{
+			first = std::min(first, i);
+			last = std::max(last, i);
+		}
+	}
+	first -= TapMargin;
+	last += TapMargin;
+	_windowLength = last - first + 1;
+
+	memset(_timeIn, 0, bytes);
+	for (int i = first; i <= last; i++)
+	{
+		auto n = (peak + i + fftSize) % fftSize;
+		_timeIn[n] = _timeOut[n];
+	}
+	fftwf_execute(_forward);
+	for (int i = 0; i < _carriers; i++)
+	{
+		_smooth[i] = _timeOut[_bin[i]];
+	}
+
+	memset(_timeIn, 0, bytes);
+	for (int i = 0; i < _carriers; i++)
+	{
+		_timeIn[_bin[i]] = 1.0f;
+	}
+	fftwf_execute(_backward);
+	memset(_timeIn, 0, bytes);
+	for (int i = first; i <= last; i++)
+	{
+		auto n = (peak + i + fftSize) % fftSize;
+		_timeIn[n] = _timeOut[n];
+	}
+	fftwf_execute(_forward);
+	for (int i = 0; i < _carriers; i++)
+	{
+		auto flat = _timeOut[_bin[i]].real();
+		if (flat > 0.1f)
+		{
+			_smooth[i] /= flat;
+		}
+		_reference[i] = std::conj(_smooth[i] * _prs[i]);
+	}
+}
+
+void CoherentDemapper::UpdateWeights(int neighbours)
+{
+	auto signal = 0.0f;
+	auto noise = 0.0f;
+	for (int i = 0; i < _carriers; i++)
+	{
+		auto first = std::max(0, i - neighbours);
+		auto last = std::min(_carriers - 1, i + neighbours);
+		auto sum = 0.0f;
+		for (int j = first; j <= last; j++)
+		{
+			sum += _noise[j];
+		}
+		auto mean = sum / (float)(last - first + 1);
+		_weight[i] = mean > 0.0f ? 2.0f / mean : 0.0f;
+		signal += std::norm(_smooth[i]);
+		noise += mean;
+	}
+	_snr = noise > 0.0f ? signal / noise : 0.0f;
+}
+
+float CoherentDemapper::Slope(int distance)
+{
+	std::complex<float> sum(0.0f, 0.0f);
+	for (int i = 0; i + distance < _carriers; i++)
+	{
+		if (_index[i + distance] - _index[i] == distance)
+		{
+			sum += _residual[i + distance] * std::conj(_residual[i]);
+		}
+	}
+	return std::arg(sum) / (float)distance;
+}
+
+void CoherentDemapper::Track(const std::complex<float>* fft, const std::complex<float>* guards, int symbols, const int* mapper, viterbi_bit_t* bits)
+{
+	const auto carriers = _carriers;
+	const auto reliability = _snr / (_snr + 2.0f);
+	const auto step = (PI_F / 2.0f) / (float)FineDistance;
+	std::complex<float> guardSum(0.0f, 0.0f);
+	auto commonPhase = 0.0f;
+	auto timingPhase = 0.0f;
+
+	for (int i = 0; i < carriers; i++)
+	{
+		_previous[4 * i + 0] = 1.0f;
+		_previous[4 * i + 1] = 0.0f;
+		_previous[4 * i + 2] = 0.0f;
+		_previous[4 * i + 3] = 0.0f;
+	}
+
+	for (int s = 1; s < symbols; s++)
+	{
+		auto spectrum = fft + (size_t)s * (size_t)_fftSize;
+		guardSum += guards[s];
+		commonPhase += std::arg(guardSum) * (float)_symbolPeriod / (float)_fftSize;
+		timingPhase += _timingRate;
+		Rotate(commonPhase + (float)s * PI_F / 4.0f, timingPhase, _rotationFirst);
+		for (int i = 0; i < carriers; i++)
+		{
+			_symbol[i] = spectrum[_bin[i]] * _reference[i] * _rotationFirst[i];
+			_residual[i] = _symbol[i] * std::conj(NearestAxis(_symbol[i])) * _weight[i];
+		}
+
+		auto coarse = Slope(CoarseDistance);
+		auto measured = Slope(FineDistance);
+		measured += step * roundf((coarse - measured) / step);
+		auto slope = reliability * TimingGain * measured;
+		Rotate(0.0f, slope, _rotation);
+		std::complex<float> common(0.0f, 0.0f);
+		for (int i = 0; i < carriers; i++)
+		{
+			common += _residual[i] * _rotation[i];
+		}
+		auto phase = std::arg(common);
+		timingPhase += slope;
+		_timingRate = std::max(-MaxTimingRate, std::min(MaxTimingRate, _timingRate + reliability * RateGain * measured));
+		commonPhase += phase;
+		Rotate(phase, slope, _rotation);
+
+		if (bits == nullptr)
+		{
+			for (int i = 0; i < carriers; i++)
+			{
+				auto v = _symbol[i] * _rotation[i];
+				auto observation = spectrum[_bin[i]] * std::conj(_prs[i]) * _rotationFirst[i] * _rotation[i] * std::conj(NearestAxis(v));
+				_sum[i] += observation;
+				_norm[i] += std::norm(observation);
+			}
+			continue;
+		}
+
+		for (int i = 0; i < carriers; i++)
+		{
+			auto v = _symbol[i] * _rotation[i];
+			auto x = _weight[i] * v.real();
+			auto y = _weight[i] * v.imag();
+			auto largest = std::max(fabsf(x), fabsf(y));
+			if (largest > MaxLogLikelihood)
+			{
+				x *= MaxLogLikelihood / largest;
+				y *= MaxLogLikelihood / largest;
+			}
+			auto ex = expf(x);
+			auto ey = expf(y);
+			float p[4];
+			p[0] = ex;
+			p[1] = ey;
+			p[2] = 1.0f / ex;
+			p[3] = 1.0f / ey;
+			auto scale = 1.0f / (p[0] + p[1] + p[2] + p[3]);
+			for (int j = 0; j < 4; j++)
+			{
+				p[j] = std::max(p[j] * scale, MinProbability);
+			}
+			auto q = _previous + 4 * i;
+			float d[4];
+			for (int n = 0; n < 4; n++)
+			{
+				d[n] = 0.0f;
+				for (int m = 0; m < 4; m++)
+				{
+					d[n] += q[m] * p[(m + n) & 3];
+				}
+			}
+			_llrRe[i] = logf((d[0] + d[3] + TinyProbability) / (d[1] + d[2] + TinyProbability));
+			_llrIm[i] = logf((d[0] + d[1] + TinyProbability) / (d[2] + d[3] + TinyProbability));
+			for (int j = 0; j < 4; j++)
+			{
+				q[j] = p[j];
+			}
+		}
+
+		auto out = bits + (size_t)(s - 1) * (size_t)carriers * 2;
+		for (int i = 0; i < carriers; i++)
+		{
+			auto j = mapper[i];
+			out[i] = ToSoftBit(-_llrRe[j]);
+			out[i + carriers] = ToSoftBit(-_llrIm[j]);
+		}
+	}
+}
+
+void CoherentDemapper::Process(const std::complex<float>* fft, const std::complex<float>* guards, int symbols, const int* mapper, viterbi_bit_t* bits)
+{
+	if (symbols < 2)
+	{
+		return;
+	}
+	const auto carriers = _carriers;
+
+	for (int i = 0; i < carriers; i++)
+	{
+		_channel[i] = fft[_bin[i]] * std::conj(_prs[i]);
+	}
+	SmoothChannel();
+	const auto share = std::min(MaxWindowShare, (float)_windowLength / (float)_fftSize);
+	for (int i = 0; i < carriers; i++)
+	{
+		_noise[i] = std::norm(_channel[i] - _smooth[i]) / (1.0f - share);
+	}
+	UpdateWeights(PilotNoiseNeighbours);
+
+	_timingRate = 0.0f;
+	BeginObservations();
+	Track(fft, guards, symbols, mapper, nullptr);
+	FinishObservations(symbols);
+
+	if (_secondPass.load(std::memory_order_relaxed))
+	{
+		for (int i = 0; i < carriers; i++)
+		{
+			_channel[i] = fft[_bin[i]] * std::conj(_prs[i]);
+		}
+		BeginObservations();
+		Track(fft, guards, symbols, mapper, nullptr);
+		FinishObservations(symbols);
+	}
+
+	Track(fft, guards, symbols, mapper, bits);
+}
+
+void CoherentDemapper::SetSecondPass(bool enabled)
+{
+	_secondPass.store(enabled, std::memory_order_relaxed);
+}
+
+void CoherentDemapper::BeginObservations()
+{
+	for (int i = 0; i < _carriers; i++)
+	{
+		_sum[i] = _channel[i];
+		_norm[i] = std::norm(_channel[i]);
+	}
+}
+
+void CoherentDemapper::FinishObservations(int symbols)
+{
+	const auto n = (float)symbols;
+	for (int i = 0; i < _carriers; i++)
+	{
+		auto mean = _sum[i] / n;
+		_channel[i] = mean;
+		_noise[i] = std::max(0.0f, (_norm[i] - n * std::norm(mean)) / (n - 1.0f));
+	}
+	SmoothChannel();
+	UpdateWeights(DataNoiseNeighbours);
+}

+
+class CoherentDemapper
+{
+private:
+	int _carriers;
+	int _fftSize;
+	int _symbolPeriod;
+	int* _bin;
+	int* _index;
+	std::complex<float>* _prs;
+	std::complex<float>* _channel;
+	std::complex<float>* _smooth;
+	std::complex<float>* _reference;
+	std::complex<float>* _symbol;
+	std::complex<float>* _residual;
+	std::complex<float>* _rotation;
+	std::complex<float>* _rotationFirst;
+	std::complex<float>* _sum;
+	std::complex<float>* _timeIn;
+	std::complex<float>* _timeOut;
+	float* _noise;
+	float* _norm;
+	float* _weight;
+	float* _power;
+	float* _sorted;
+	float* _previous;
+	float* _llrRe;
+	float* _llrIm;
+	float _snr;
+	float _timingRate;
+	int _windowLength;
+	std::atomic<bool> _secondPass;
+	fftwf_plan_s* _forward;
+	fftwf_plan_s* _backward;
+
+	void Rotate(float phase, float slope, std::complex<float>* out);
+	void SmoothChannel();
+	void UpdateWeights(int neighbours);
+	float Slope(int distance);
+	void BeginObservations();
+	void FinishObservations(int symbols);
+	void Track(const std::complex<float>* fft, const std::complex<float>* guards, int symbols, const int* mapper, viterbi_bit_t* bits);
+
+public:
+	CoherentDemapper(int carriers, int fftSize, int symbolPeriod, const std::complex<float>* prsFft);
+	~CoherentDemapper();
+
+	void SetSecondPass(bool enabled);
+
+	void Process(const std::complex<float>* fft, const std::complex<float>* guards, int symbols, const int* mapper, viterbi_bit_t* bits);
+};

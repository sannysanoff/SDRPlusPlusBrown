/*
 * Version resource for the ftd2xx logging proxy: the vendor's ExtIO_Osa.dll
 * statically imports VERSION.DLL and calls GetFileVersionInfoSizeA/
 * GetFileVersionInfoA/VerQueryValueA on the loaded D2XX library right after
 * FT_CreateDeviceInfoList, and refuses to run when the version resource is
 * absent. The values below mirror the real 32-bit ftd2xx.dll on this machine
 * (FileVersion 3.2.21.1, CDM driver package 2.12.36.20), so the vendor's
 * driver-version check passes and the capture can proceed. Diagnostic use
 * only, on the operator's own machine.
 */
1 VERSIONINFO
FILEVERSION     3,2,21,1
PRODUCTVERSION  2,12,36,20
FILEOS          0x40004L
FILETYPE        0x2L
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Future Technology Devices International Ltd."
      VALUE "FileDescription", "FTD2XX Dynamic Library"
      VALUE "FileVersion", "3.2.21.1"
      VALUE "InternalName", "FTD2XX.DLL"
      VALUE "LegalCopyright", "Copyright (C) 2001-2024"
      VALUE "OriginalFilename", "FTD2XX.DLL"
      VALUE "ProductName", "FTDIChip CDM Drivers"
      VALUE "ProductVersion", "2.12.36.20"
    END
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Future Technology Devices International Ltd."
      VALUE "FileDescription", "FTD2XX Dynamic Library"
      VALUE "FileVersion", "3.2.21.1"
      VALUE "InternalName", "FTD2XX.DLL"
      VALUE "LegalCopyright", "Copyright (C) 2001-2024"
      VALUE "OriginalFilename", "FTD2XX.DLL"
      VALUE "ProductName", "FTDIChip CDM Drivers"
      VALUE "ProductVersion", "2.12.36.20"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
